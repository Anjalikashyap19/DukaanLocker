<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- RELEASE/PRODUCTION: HTTPS only. Cleartext (HTTP) is never permitted.
         Debug-only cleartext hosts (localhost / emulator / LAN backend) are
         overridden in src/debug/res/xml/network_security_config.xml. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
