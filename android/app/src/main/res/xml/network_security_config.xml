<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) only to the local backend. The emulator reaches
         the host machine at 10.0.2.2; a real device uses the LAN IP (or adb reverse
         + localhost). Production HTTPS traffic to api.dukaanlocker.iadv.cloud
         is unaffected. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.176.2.52</domain>
    </domain-config>
</network-security-config>
